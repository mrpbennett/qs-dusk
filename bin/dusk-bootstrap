#!/usr/bin/env bash
# Dusk self-bootstrap — run by the Dusk bar widget the first time it loads.
#
# Delegates installation and repair checks to the shared installer.

set -euo pipefail

PLUGIN_DIR="${PLUGIN_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Direct installs keep runtime files outside the widget directory. The marker
# lets the copied bootstrap validate and repair that same source tree.
if [[ -z ${DUSK_HOME:-} && -f "$PLUGIN_DIR/.dusk-home" ]]; then
  IFS= read -r DUSK_HOME < "$PLUGIN_DIR/.dusk-home"
fi
DUSK_HOME="${DUSK_HOME:-$PLUGIN_DIR}"
DUSK_SOURCE_DIR="${DUSK_SOURCE_DIR:-$DUSK_HOME}"
export DUSK_HOME DUSK_SOURCE_DIR PLUGIN_DIR

exec "$DUSK_HOME/bin/dusk-install" "$@"
